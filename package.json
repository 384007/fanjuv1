    "seo:drafts:router:en": "LANG=en node scripts/seo/generate-router-drafts.mjs",
    "modal:growth:deploy": "python3 -m modal deploy modal_growth_agent.py",
    "modal:growth:serve": "python3 -m modal serve modal_growth_agent.py",
    "seo:promote-ready": "node scripts/seo/promote-ready-drafts.mjs",
    "seo:fix-drafts": "node scripts/seo/fix-draft-quality.mjs",
    "seo:publish-ready": "node scripts/seo/publish-ready-draft.mjs",
    "seo:check-ready-routes": "node scripts/check-seo-ready-routes.mjs",
    "seo:ready:bilingual": "node scripts/seo/run-bilingual-ready-drafts.mjs",
    "seo:verify:bilingual": "node scripts/seo/verify-bilingual-ready-run.mjs",
    "seo:routes": "node scripts/seo/build-route-manifest.mjs && node scripts/seo/build-route-manifest-v2.mjs",
    "seo:sitemap": "node scripts/generate-sitemaps.mjs",
    "seo:validate-indexability": "node scripts/seo/build-route-manifest-v2.mjs && node scripts/generate-sitemaps.mjs && node scripts/seo/validate-indexability.mjs",
    "seo:prompt-bank": "node scripts/seo/build-random-prompt-bank.mjs",
    "seo:prompt-bank:run": "node scripts/seo/run-prompt-bank-drafts.mjs",
    "seo:prompt-bank:cloudflare": "node scripts/seo/run-prompt-bank-to-cloudflare.mjs",
    "seo:city-cluster:publish": "node scripts/seo/publish-city-cluster.mjs",
    "seo:cloudflare:submit": "node scripts/seo/submit-cloudflare-article-urls.mjs",
    "seo:prompt-bank:check": "node scripts/seo/check-prompt-bank-diversity.mjs",
    "seo:keys:test": "node scripts/seo/test-all-keys.mjs",
    "seo:routes:check": "node scripts/seo/check-route-coverage.mjs",
    "seo:live:check": "node scripts/seo/check-live-routes.mjs",
    "seo:article:live:check": "node scripts/seo/check-live-article-content.mjs",
    "seo:sitemap:live:contains": "node scripts/seo/check-live-sitemap-contains.mjs",
    "seo:i18n:check": "node scripts/seo/check-i18n-coverage.mjs",
    "seo:locale:check": "node scripts/seo/check-locale-content.mjs",
    "seo:pages:check": "node scripts/seo/check-built-pages.mjs",
    "seo:city-topic:check": "node scripts/seo/check-city-topic-pages.mjs",
    "seo:serve:export": "node scripts/seo/serve-export-clean-urls.mjs",
    "seo:exported-pages:check": "node scripts/seo/check-exported-sitemap-pages.mjs",
    "seo:browser:sitemap": "node scripts/seo/check-sitemap-headless-chrome.mjs",
    "seo:public:check": "node scripts/seo/check-public-no-tech-leak.mjs",
    "seo:indexability:check": "node scripts/seo/check-indexability.mjs",
    "seo:taxonomy": "node scripts/seo/generate-taxonomy.mjs",
    "seo:topics": "node scripts/seo/generate-topic-candidates.mjs",
    "seo:articles": "node scripts/seo/generate-ai-seo-articles.mjs",
    "seo:audit:links": "node scripts/seo/audit-article-links.mjs",
    "seo:audit:quality": "node scripts/seo/audit-article-quality.mjs",
    "seo:audit:sitemap": "node scripts/seo/audit-sitemap-indexability.mjs",
    "seo:content:all": "pnpm seo:taxonomy && pnpm seo:topics && pnpm seo:articles && pnpm seo:audit:links && pnpm seo:audit:quality && pnpm seo:audit:sitemap"
