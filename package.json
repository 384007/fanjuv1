    "build:static-og": "node scripts/generate-static-og-images.mjs",
    "start": "next start",
    "lint": "eslint .",
    "cf:build": "pnpm build",
    "cf:deploy": "pnpm cf:build && npx wrangler pages deploy out --project-name fanjuv1 --commit-dirty=true",
    "cf:deploy:pages": "pnpm cf:build && npx wrangler pages deploy out --project-name fanjuv1 --commit-dirty=true",
    "ship": "node scripts/ship.mjs",
    "generate:sitemaps": "node scripts/generate-sitemaps.mjs",
    "content:generate": "node scripts/generate-variants.mjs",
    "social:pack": "node scripts/generate-social-pack.mjs && node scripts/make-manual-post-pack.mjs",
