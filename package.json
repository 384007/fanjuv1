    "content:test": "DRY_RUN=1 npm run content:generate && DRY_RUN=1 npm run social:pack && DRY_RUN=1 npm run social:publish:devto && DRY_RUN=1 npm run social:publish:hashnode && DRY_RUN=1 npm run social:publish:bluesky && DRY_RUN=1 npm run social:publish:mastodon && DRY_RUN=1 npm run social:publish:gist && DRY_RUN=1 npm run seo:submit:indexnow && DRY_RUN=1 npm run seo:submit:baidu",
    "submit:baidu": "node scripts/submit-baidu.mjs",
    "modal:serve": "modal serve modal_app.py",
    "modal:deploy": "modal deploy modal_app.py",
    "seo:opportunities": "node scripts/seo/build-opportunities.mjs",
    "seo:drafts": "node scripts/seo/generate-drafts.mjs",
    "seo:drafts:nvidia": "node scripts/seo/generate-nvidia-drafts.mjs",
    "seo:drafts:groq": "node scripts/seo/generate-groq-drafts.mjs",
    "seo:test:providers": "node scripts/seo/test-ai-providers.mjs",
